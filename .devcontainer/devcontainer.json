{
  "name": "Node.js & TypeScript",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:4-24-trixie",
  "mounts": [
    "source=pnpm-store-cache,target=/home/node/.local/share/pnpm/store,type=volume",
    "source=cursor-cli-config,target=/home/node/.cursor,type=volume"
  ],
  "postCreateCommand": "bash ./.devcontainer/devcontainer.sh",
  "forwardPorts": [3000, 5000],
  "portsAttributes": {
    "3000": { "label": "web" },
    "5000": { "label": "api" },
    "5001": { "label": "worker" }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "version": "latest",
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest",
      "installDirectlyFromGitHubRelease": true
    }
  }
}
