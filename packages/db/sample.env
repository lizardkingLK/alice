# Direct (non-pooled) Postgres URL for Prisma migrate / generate / seed SQL.
# Pooled runtime URL lives on apps/api as DATABASE_URL — not required here.
DIRECT_URL="YOUR_DIRECT_URL"
SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Same 32-byte Base64 key as apps/api (AES-GCM for chat agent / tool instructions).
# Seed also falls back to apps/api/.env when this is unset.
INTEGRATION_TOKEN_ENCRYPTION_KEY="YOUR_BASE64_32_BYTE_KEY"
