DATABASE_URL="YOUR_DATABASE_URL"
DIRECT_URL="YOUR_DIRECT_URL"
SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Required for `pnpm db seed` — dev password for sample auth accounts
SEED_USER_PASSWORD="YOUR_DEV_SEED_PASSWORD"

# Optional. `pnpm db seed:reset` (or SEED_RESET=1) wipes public rows, auth.users,
# and Alice storage buckets before seeding. Default `pnpm db seed` stays idempotent.
