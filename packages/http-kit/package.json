{
  "name": "@repo/http-kit",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf .turbo node_modules/.cache/turbo dist",
    "lint": "eslint . --max-warnings 0",
    "checktypes": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "cors": "^2.8.5",
    "detect-port": "^2.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "5.9.2",
    "vitest": "^4.1.9"
  }
}
