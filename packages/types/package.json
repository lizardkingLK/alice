{
  "name": "@repo/types",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "zod": "^4.4.3"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./audit": {
      "types": "./src/audit.ts",
      "require": "./dist/audit.js",
      "default": "./dist/audit.js"
    },
    "./database": {
      "types": "./src/generated/supabase/database.types.ts",
      "require": "./dist/generated/supabase/database.types.js",
      "default": "./dist/generated/supabase/database.types.js"
    },
    "./connection": {
      "types": "./src/connection",
      "require": "./dist/connection/index.js",
      "default": "./dist/connection/index.js"
    },
    "./prisma": {
      "types": "./src/generated/prisma/client.ts",
      "require": "./dist/generated/prisma/client.js",
      "default": "./dist/generated/prisma/client.js"
    },
    "./api/v1": {
      "types": "./src/api/v1/index.ts",
      "require": "./dist/api/v1/index.js",
      "default": "./dist/api/v1/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf .turbo node_modules/.cache/turbo",
    "lint": "eslint . --max-warnings 0 --no-warn-ignored",
    "checktypes": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "5.9.2"
  }
}
