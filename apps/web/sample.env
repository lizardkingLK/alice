# Public variables only — safe for local .env.local and Vercel (client + server).

# Required
NEXT_PUBLIC_API_URL="https://your-api.example.com"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional — app builds and runs without these (warnings only if missing)
NEXT_PUBLIC_SITE_URL="https://your-web.example.com"

# Supabase auth external google client secret
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET="your-supabase-auth-external-google-client-secret"

# Server-only secret — do NOT add to this file for production templates.
# Set SUPABASE_SERVICE_ROLE_KEY in Vercel → Environment Variables (never NEXT_PUBLIC_).

# Server-only app toggle (web RSC reads). Unset / false = supabase-js SSR (default).
# true | 1 | yes = Express Prisma GETs for allowlisted domains (work-items first).
# Never NEXT_PUBLIC_. On Vercel set this on the **web** project (Preview vs
# Production can differ). A new deployment picks up the value; it is not
# per-request. See docs/architecture/DATA_RETRIEVAL.md
# DATA_READS_VIA_API=false

# Docker only environment variable
# INTERNAL_API_URL=hanlded on ./script_deploy_docker.sh

# Cypress E2E Test Credentials
CYPRESS_TEST_USER_EMAIL="your-test-email@example.com"
CYPRESS_TEST_USER_PASSWORD="your-test-password"